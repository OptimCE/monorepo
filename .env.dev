#Step 0 - Global configuration
DOMAIN=http://localhost

# Step 1 - Public application routing
APP_CORS_ALLOWED_ORIGIN=http://localhost
WEB_BASE_PATH=/
WEB_API_URL=/api

# Step 2 - Identity provider (Keycloak)
AUTH_REALM=optimce-realm
AUTH_INTERNAL_URL=http://keycloak:8080/keycloak
AUTH_CLIENT_SECRET=changeme_keycloak_admin_password
WEB_AUTH_URL=/keycloak
WEB_AUTH_CLIENT_ID=optimce-frontend
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin

# Step 3 - Database configuration
#
# ONE Postgres instance (compose service `postgres`, host port 8080) holds six
# logical databases; `keycloak-db` remains a separate instance on 8081.
#
# Each value below is now the password of ONE LOGIN ROLE, not of an instance's
# superuser. A role reaches its own database plus the least-privilege slice of
# crm_db its service actually uses, so a leaked value no longer reaches anything
# else. See postgres/README.md for the role table and the grant matrix.
#
# To rotate any of them: edit here, then `./docker-stack.sh restart` — NOT
# `start`. postgres-init re-asserts every password on every run, but a running
# application container keeps the environment it was created with.
POSTGRES_SUPERUSER_PASSWORD=changeme_postgres_superuser_password
CRM_DB_PASSWORD=changeme_db_password
KEYCLOAK_DB_PASSWORD=changeme_keycloak_db_password
ALLOCATION_KEY_DB_PASSWORD=changeme_allocation_key_db_password
SIMULATION_KEY_DB_PASSWORD=changeme_simulation_key_db_password
NEWS_BOARD_DB_PASSWORD=changeme_news_board_db_password
BILLING_DB_PASSWORD=changeme_billing_db_password
ADMINISTRATIVE_DOCUMENT_DB_PASSWORD=changeme_administrative_document_db_password
NOTIFICATION_DISPATCH_DB_PASSWORD=changeme_notification_dispatch_db_password

# Step 4 - Storage configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
STORAGE_BUCKET=crm-files
STORAGE_API_URL=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:8091

# Step 5 - OpenTelemetry
REMOTE_LOGGING=false
OTEL_EXPORTER_OTLP_ENDPOINT=none

# Step 6 - Email delivery (notification-dispatch)
# SMTP | BREVO. SMTP points at the Mailpit container, so a local run can never
# reach a real mailbox — read what was "sent" at http://localhost:8007.
# To exercise the production path, set EMAIL_TRANSPORT=BREVO and BREVO_API_KEY.
EMAIL_TRANSPORT=SMTP
EMAIL_FROM_ADDRESS=no-reply@optimce.be
EMAIL_FROM_NAME=OptimCE
EMAIL_REPLY_TO=contact@optimce.be
# Domain for the stable Message-ID that lets a client collapse an at-least-once
# duplicate. Defaults to the sender's domain when empty.
EMAIL_MESSAGE_ID_DOMAIN=optimce.be
# Applied to any queued message whose recipient never chose a language.
EMAIL_DEFAULT_LOCALE=fr
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com
# Brevo reports bounces by webhook only, and notification-dispatch has no
# inbound HTTP surface by design, so it polls the blocked-contact list instead.
# 0 disables the sync.
BREVO_SUPPRESSION_SYNC_INTERVAL_SECONDS=3600
DISPATCH_POLL_INTERVAL_SECONDS=15

# Step 7 - Reverse Proxy
USE_HTTPS=false
SSL_EMAIL=admin@example.com
DOMAIN_HOST=localhost
SSL_CERT_PATH=/etc/letsencrypt/live/localhost/fullchain.pem
SSL_CERT_KEY_PATH=/etc/letsencrypt/live/localhost/privkey.pem

# Step 8 - Realtime (SSE, bypassing the API gateway)
#
# The whole feature's kill switch. With REALTIME_ENABLED=false the ticket
# endpoint 503s, crm-backend opens no Redis connection and binds nothing, every
# Python emit() is a silent no-op, and the SPA sits in `fallback` polling exactly
# as it did before this feature existed. That is both the rollout and the
# rollback.
#
# Why a bypass at all: EventSource cannot send an Authorization header, so
# nothing behind KrakenD's auth/validator is reachable by it — and KrakenD
# buffers + JSON-decodes with a 3000ms global timeout. Authority is minted behind
# the gateway (POST /api/notifications/realtime/ticket) and spent on the bypass
# leg (GET ${WEB_REALTIME_PATH}). See docs/runbooks/.
#
# Redis logical db 1 on purpose: db 0 stays reserved for crm-backend's currently
# dormant cache_service, which is a DIFFERENT switch. REALTIME_REDIS_URL is
# composed in docker-compose.dev.yml from REDIS_PASSWORD so the secret lives in
# exactly one place.
REALTIME_ENABLED=true
REDIS_PASSWORD=changeme_redis_password
# Must match `location = ${WEB_REALTIME_PATH}` in nginx/conf-template.d/*: both
# the nginx conf and crm-frontend's config.json are rendered from this one value,
# so they cannot drift.
WEB_REALTIME_PATH=/realtime/stream

# ---- Map basemap -----------------------------------------------------------
#
# MapLibre style JSON for the meters and public-communities maps. The default
# below is the OpenFreeMap public instance: no API key, no registration, no
# request limit, commercial use allowed, OpenStreetMap data under ODbL. It is
# the first third-party runtime dependency the frontend has, so if that matters
# for your deployment, point this at a self-hosted style instead.
#
# A self-hosted style MUST serve "Noto Sans Regular" from its `glyphs` endpoint,
# or override `map.fontStack` in config.json: the cluster and coincidence count
# badges are symbol layers, and a missing font makes every count label vanish
# with nothing logged.
#
# Left unset, envsubst renders "" into config.json; environments.ts treats an
# empty string as absent and falls back to the same default.
WEB_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Long enough for POST -> new EventSource() on a slow mobile RTT, short enough
# that a ticket recovered from a log is already dead.
REALTIME_TICKET_TTL_SECONDS=30
# Absolute stream lifetime. This is the revocation window AND the bound on what a
# leaked 30s ticket buys: without it a spent ticket yields an unbounded stream.
REALTIME_MAX_CONNECTION_SECONDS=900
REALTIME_MAX_CONNECTIONS_PER_USER=4

# ---- Step 9: Address geocoding and the address picker ----------------------
#
# GEOCODING_MODE decides how an address becomes a point on the map:
#   OFF    no adapters bound; addresses stay unplotted and the map still works
#   LOCAL  hand-placed pins + the commune centroid already in municipality.geo_point
#   REMOTE LOCAL plus the two free Belgian public geocoders (SPW ICAR for
#          Wallonia, Vlaanderen Geolocation for Flanders/Brussels), used by
#          POST /geocoding/backfill only
#
# The inline chain stays local whatever this says: KrakenD's global timeout is
# 3000 ms with no per-endpoint override, so a third party between the user and
# POST /meters is a 504 waiting for a slow morning at the SPW.
GEOCODING_MODE=LOCAL
GEOCODING_TIMEOUT_MS=2000
# Hard ceiling on one backfill batch, so a typo cannot start an hours-long run
# against a free public service.
GEOCODING_BATCH_MAX=1000
# Keycloak user ids (comma-separated) allowed to run POST /geocoding/backfill.
# It geocodes EVERY community's addresses, so being some community's ADMIN is not
# enough (anyone can create a community). Empty = nobody. Dev: the demo user.
GEOCODING_BACKFILL_OPERATORS=f298d22b-4e19-4150-a4d4-f852c60163b3

# The federal BeSt Address register (FPS BOSA), self-hosted as the `best-address`
# container, which starts with the rest of the stack.
#
# Unlike the two public geocoders this one is OURS, on the `backend` network, so
# it is the one network adapter allowed on the inline write path — which is what
# upgrades a new meter's pin from the commune centre to its actual roof.
#
# BLANKING THIS IS THE OFF SWITCH: with no URL the address picker is unbound,
# GET /geocoding/suggest returns an empty list, and every address form behaves
# exactly as it did before the feature existed. Blank it and
# `./docker-stack.sh stop -s best-address` if you need the ~1.7 GB back; note
# that a DELETED line is not the off switch, since compose falls back to this
# same default when the variable is unset.
#
# Costs ~1.7 GB of RAM. On Docker Desktop that usually means raising the WSL2
# ceiling first (%UserProfile%\.wslconfig -> memory=12GB, then `wsl --shutdown`).
BEST_ADDRESS_URL=http://best-address:8080/belgianAddress/v2
# Well inside the 3000 ms gateway budget. The box answers an indexed lookup in
# tens of milliseconds once warm; this is the ceiling for a bad day, not a target.
BEST_ADDRESS_TIMEOUT_MS=1500

# ---- Annex catalogue (crm-backend) -----------------------------------------
#
# crm-backend's config/annexes-services.json is baked into its image and shared
# with production. An annex whose service is not deployed everywhere ships with
# "defaultEnabled": false, and each deployment opts in here. Comma-separated
# `feature` names; empty = none. DISABLE hides an entry and wins over ENABLE.
#
# Only name features the crm-backend you run contains. An unknown name refuses
# the boot, and under `tsx watch` the container stays up, so the only sign is
# the log line `annexes_services:catalog_overrides`. The set actually served is
# logged once at boot as `annexes_services:catalog_loaded`.
#
# Read once at boot: `./docker-stack.sh restart -s crm-backend` after a change
# (a plain `docker compose restart` keeps the old environment).
#
# live-data is default-off because production does not run its service. Commit
# this line only together with a crm-backend submodule bump whose catalogue has
# the live-data entry; older checkouts would refuse to boot.
ANNEX_CATALOG_ENABLE=live-data
ANNEX_CATALOG_DISABLE=

# ---- Step 10: Live Data (MQTT telemetry) -----------------------------------
#
# Quarter-hour telemetry published by smart-meter connectors over MQTT, ingested
# by the `live-data` service. Build steps 1-5: ingestion and enrolment, no read
# API and no frontend yet.
#
# The data is INDICATIVE. The DSO's data remains the only basis for allocation
# keys and invoicing, and every live view says so - stamped by the server,
# because the SPA is one of three clients.

# The owned database, alongside the other seven *_svc roles.
LIVE_DATA_DB_PASSWORD=changeme_live_data_db_password

# ---- the broker's dynamic-security administrator ----
#
# Mosquitto's dynamic-security plugin keeps its whole client/role/ACL state in
# one JSON file, and this identity is what the bootstrap one-shot creates and
# what the API uses to enrol and revoke devices over the $CONTROL topic API.
#
# THE BOOTSTRAP MUST RUN BEFORE THE BROKER, and `mosquitto-init` is ordered that
# way. On Mosquitto 2.1.x a MISSING dynamic-security.json is not a startup
# error: the broker generates its own, complete with a `democlient`, a
# `super-admin` role, an `unauthenticated` group, and a `.pw` file holding both
# passwords in PLAINTEXT - while looking perfectly healthy, because only
# enrolment fails. If you ever see `dynamic-security.json.pw` in the mosquitto
# volume, that is what happened.
MOSQUITTO_DYNSEC_USER=optimce-admin
MOSQUITTO_DYNSEC_PASSWORD=changeme_mosquitto_dynsec_password

# ---- what a device is told, and what it can never be told again ----
#
# LIVE_DATA_BROKER_PUBLIC_HOST goes into the enrolment response, and from there
# into the device's NVS, where it is stored ONCE and never asked for again. It
# is NOT the address the API and worker dial (that is `mosquitto`, on the
# backend network, and it never leaves the compose file).
#
# Handing out an internal name here would brick every enrolled device
# permanently: there is no OTA, no command topic, and the fix is a site visit to
# a box with no keyboard. core/config.py asserts the two differ in
# staging/production; in dev they differ too, which is why the simulator runs
# INSIDE the compose network rather than from the host.
#
# D-3 (2026-09-14): mqtt.optimce.be.
LIVE_DATA_BROKER_PUBLIC_HOST=mqtt.optimce.be
LIVE_DATA_BROKER_PUBLIC_PORT=8883
LIVE_DATA_BROKER_PUBLIC_TLS=true

# ---- the public enrolment leg's rate limit ----
#
# `POST /api/live-public/enroll` is the platform's FIRST unauthenticated
# endpoint. The service cannot rate-limit it itself: KrakenD's input-header
# allow-list excludes X-Forwarded-For and X-Real-IP, so `request.client.host` is
# the gateway's container address for every caller. nginx is the only place that
# can see a real client IP.
#
# Referenced by BOTH nginx templates. If this variable is missing, envsubst
# renders `rate=;` and NGINX REFUSES TO START - taking the whole reverse proxy
# with it, at stack-start time. Do not delete it; set it to a high value if you
# want the limit effectively off.
LIVE_ENROLL_RATE_LIMIT=6r/m

# The worker's own broker identity, carrying the `ingest` role.
#
# NOT the dynsec admin. The admin's role grants publish on $CONTROL and NOTHING
# on ce/#, so a worker connecting as the admin subscribes successfully, receives
# a normal SUBACK, and is then delivered nothing at all - for ever, with no error
# at either end. A SUBACK cannot distinguish that from success, which is why this
# identity is separate and why mosquitto-roles asserts the role's ACLs.
MQTT_INGEST_USERNAME=live-data-ingest
MQTT_INGEST_PASSWORD=changeme_live_data_ingest_password
