# The provisioning scripts and their SQL are mounted into a Linux container and
# executed by busybox `sh` and `psql`. This repo is developed on Windows with
# core.autocrlf=true, which would hand the container CRLF files — `provision.sh`
# then dies on a stray \r and the whole stack refuses to start, with an error
# that points nowhere near the cause. Pin them.
postgres/**/*.sh   text eol=lf
postgres/**/*.sql  text eol=lf

# The same trap, one directory over: scripts/*.sh run on the HOST under Git
# Bash, where a checked-out CRLF line ending is just as fatal - bash reports
# `$'\r': command not found` and nothing else, pointing at a blank line.
scripts/**/*.sh    text eol=lf

# And the entry point itself, for the same reason: docker-stack.sh runs under
# Git Bash, and `survey-ean` hands one of the pinned postgres/ scripts to
# `docker compose run --entrypoint`. A CRLF docker-stack.sh fails the same way.
docker-stack.sh    text eol=lf
