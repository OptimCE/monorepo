{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimce.be/contracts/export/files/allocation-key-generation/generated-iterations.schema.json",
  "title": "allocation-key-generation/generated-iterations.json item",
  "description": "Community export: one `iteration_generated` row of the community, as stored (minus `id_community`, the scope), codes by name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "id_allocation_key",
    "number",
    "energy_allocated_percentage",
    "surplus_total",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "id_allocation_key": {
      "type": "integer"
    },
    "number": {
      "type": "integer"
    },
    "energy_allocated_percentage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "surplus_total": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
