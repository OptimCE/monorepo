{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimce.be/contracts/export/files/administrative-document/version-checks.schema.json",
  "title": "administrative-document/version-checks.json item",
  "description": "Community export: one `version_check` row of the community, as stored (minus `id_community`, the scope), codes by name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "id_document_version",
    "docgen_request_id",
    "outcome",
    "content_sha256",
    "renderer_json",
    "error_json",
    "requested_by",
    "requested_at",
    "checked_at"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "id_document_version": {
      "type": "integer"
    },
    "docgen_request_id": {
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "IDENTICAL",
            "DIFFERENT",
            "FAILED"
          ]
        },
        {
          "type": "integer"
        }
      ],
      "description": "CheckOutcome by name (a retired code keeps its number)."
    },
    "content_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "renderer_json": {
      "$ref": "common.schema.json#/$defs/json"
    },
    "error_json": {
      "$ref": "common.schema.json#/$defs/json"
    },
    "requested_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "checked_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
