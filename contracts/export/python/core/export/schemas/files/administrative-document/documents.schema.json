{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimce.be/contracts/export/files/administrative-document/documents.schema.json",
  "title": "administrative-document/documents.json item",
  "description": "Community export: one `document` row of the community, as stored (minus `id_community`, the scope), codes by name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "id_dossier",
    "doc_type",
    "origin",
    "status",
    "current_version_id",
    "title",
    "kind",
    "required",
    "requirement_code",
    "condition_json",
    "id_member",
    "id_template",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "id_dossier": {
      "type": "integer"
    },
    "doc_type": {
      "type": "string"
    },
    "origin": {
      "anyOf": [
        {
          "enum": [
            "GENERATED",
            "UPLOADED"
          ]
        },
        {
          "type": "integer"
        }
      ],
      "description": "DocOrigin by name (a retired code keeps its number)."
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "READY",
            "OBSOLETE",
            "MISSING",
            "STALE",
            "SIGNED",
            "REJECTED"
          ]
        },
        {
          "type": "integer"
        }
      ],
      "description": "ProcedureDocumentStatus by name (a retired code keeps its number)."
    },
    "current_version_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "GENERATED",
            "COLLECTED",
            "RECEIVED"
          ]
        },
        {
          "type": "integer"
        }
      ],
      "description": "DocumentKind by name (a retired code keeps its number)."
    },
    "required": {
      "type": "boolean"
    },
    "requirement_code": {
      "type": "string"
    },
    "condition_json": {
      "$ref": "common.schema.json#/$defs/json"
    },
    "id_member": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "id_template": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
