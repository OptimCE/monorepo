{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimce.be/contracts/export/files/administrative-document/piece-signatures.schema.json",
  "title": "administrative-document/piece-signatures.json item",
  "description": "Community export: one `piece_signature` row of the community, as stored (minus `id_community`, the scope), codes by name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "id_document",
    "id_version",
    "idempotency_key",
    "request_id",
    "status",
    "reason",
    "id_signed_version",
    "final_sha256",
    "requested_by",
    "requested_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "id_document": {
      "type": "integer"
    },
    "id_version": {
      "type": "integer"
    },
    "idempotency_key": {
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "REQUESTED",
            "OPEN",
            "SIGNED",
            "DECLINED",
            "EXPIRED",
            "CANCELLED",
            "FAILED"
          ]
        },
        {
          "type": "integer"
        }
      ],
      "description": "PieceSignatureStatus by name (a retired code keeps its number)."
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id_signed_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
