{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimce.be/contracts/export/files/administrative-document/inbound-mails.schema.json",
  "title": "administrative-document/inbound-mails.json item",
  "description": "Community export: one `inbound_mail` row of the community, as stored (minus `id_community`, the scope), codes by name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "id_inbound_address",
    "message_id",
    "content_sha256",
    "byte_size",
    "from_address",
    "subject",
    "sent_at",
    "body_text",
    "received_at",
    "status",
    "id_dossier",
    "match_reason",
    "suggested_response",
    "id_correspondence",
    "handled_by",
    "handled_at",
    "updated_at",
    "file"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "id_inbound_address": {
      "type": "integer"
    },
    "message_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_sha256": {
      "type": "string"
    },
    "byte_size": {
      "type": "integer"
    },
    "from_address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sent_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "body_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "received_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "UNMATCHED",
            "ATTACHED",
            "RECORDED",
            "DISCARDED"
          ]
        },
        {
          "type": "integer"
        }
      ],
      "description": "InboundMailStatus by name (a retired code keeps its number)."
    },
    "id_dossier": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "match_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "suggested_response": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id_correspondence": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "handled_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "handled_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "file": {
      "$ref": "common.schema.json#/$defs/fileRef"
    }
  }
}
