{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimce.be/contracts/export/files/news-board/my-posts.schema.json",
  "title": "news-board/my-posts.json item",
  "description": "User export: a post or poll the requester published, in any community, with its options.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id_community",
    "community",
    "id",
    "type",
    "post",
    "expires_at",
    "admin_visibility",
    "member_visibility",
    "member_display",
    "created_at",
    "updated_at",
    "options"
  ],
  "properties": {
    "id_community": {
      "type": "integer"
    },
    "community": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "integer"
    },
    "type": {
      "$ref": "common.schema.json#/$defs/postType"
    },
    "post": {
      "type": "string",
      "description": "The Markdown text, as written."
    },
    "expires_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "admin_visibility": {
      "$ref": "common.schema.json#/$defs/adminVisibility"
    },
    "member_visibility": {
      "$ref": "common.schema.json#/$defs/memberVisibility"
    },
    "member_display": {
      "$ref": "common.schema.json#/$defs/memberDisplay"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "option_value",
          "display_order"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "option_value": {
            "type": "string"
          },
          "display_order": {
            "type": "integer"
          }
        }
      }
    }
  }
}
