{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://optimce.be/contracts/export/files/administrative-document/digest-settings.schema.json",
  "title": "administrative-document/digest-settings.json item",
  "description": "Community export: one `digest_setting` row of the community, as stored (minus `id_community`, the scope), codes by name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "cadence",
    "weekday",
    "first_on",
    "recipient_ids",
    "enabled_at",
    "period_from",
    "last_due_on",
    "updated_at",
    "updated_by"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "cadence": {
      "anyOf": [
        {
          "enum": [
            "WORKING_DAYS",
            "WEEKLY",
            "BIWEEKLY",
            "MONTHLY"
          ]
        },
        {
          "type": "integer"
        }
      ],
      "description": "DigestCadence by name (a retired code keeps its number)."
    },
    "weekday": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_on": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "recipient_ids": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "enabled_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "period_from": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_due_on": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
